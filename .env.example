# Key NAMES only. Never put real values in this file.
# Copy to .env.local and fill in locally. .env.local is gitignored.

# Supabase (project ref: csvuhyeplcxvzlvkduwj)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY — never import in a client component
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SERVER-ONLY — never import in a client component
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# REQUIRED. Unique per environment; tags your Checkout sessions so your webhook ignores
# teammates' (we share one Stripe test account). Locally use your name, e.g. local-jose.
# On Vercel use something like vercel-dev. Payments are disabled until it is set.
STRIPE_SITE_TAG=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
